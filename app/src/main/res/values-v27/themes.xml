<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        windowLightStatusBar доступен с API 23, windowLightNavigationBar — только с API 27.
        На API 26 атрибут отсутствует в платформе, поэтому тема уходит в values-v27.
    -->
    <style name="Theme.PromtLab" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/promtlab_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
